--==============================================================
-- TELEPORTES IN-GAME (Computer / Exit / Freezer)
--==============================================================
local function getRoot()
    local char = player.Character or player.CharacterAdded:Wait()
    return char, char:WaitForChild("HumanoidRootPart")
end

local function getOrderedModels(name)
    local models = {}
    local function scan(parent)
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("Model") and obj.Name == name then
                table.insert(models, obj)
            end
            if #obj:GetChildren() > 0 then scan(obj) end
        end
    end
    scan(Workspace)
    table.sort(models, function(a, b)
        local ao = a:GetAttribute("Order") or 0
        local bo = b:GetAttribute("Order") or 0
        return ao < bo
    end)
    return models
end

local function TeleportToModel(model)
    if not model or not model.PrimaryPart then return end
    local char, root = getRoot()
    local front = model.PrimaryPart.CFrame.Position + model.PrimaryPart.CFrame.LookVector * 5
    root.CFrame = CFrame.new(front)
end

local computerIndex, exitIndex, freezerIndex = 1, 1, 1

tpstab:Label("Áreas In-Game (rotativo).")

tpstab:Button("TP Computador (rotativo)", function()
    local models = getOrderedModels("ComputerTable")
    if #models == 0 then notify("TP", "Nenhum computador.") return end
    TeleportToModel(models[computerIndex])
    computerIndex = computerIndex + 1
    if computerIndex > #models then computerIndex = 1 end
end)

tpstab:Button("TP Saída (rotativo)", function()
    local models = getOrderedModels("ExitDoor")
    if #models == 0 then notify("TP", "Nenhuma saída.") return end
    TeleportToModel(models[exitIndex])
    exitIndex = exitIndex + 1
    if exitIndex > #models then exitIndex = 1 end
end)

