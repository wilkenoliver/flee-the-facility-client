--==============================================================
-- SPEED (com persistência anti-kick do humanoid)
--==============================================================
getgenv().Xct.applySpeed = function()
    if not getgenv().Xct.lastWalkSpeed then return end
    local char = player.Character or player.CharacterAdded:Wait()
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if hum.WalkSpeed ~= getgenv().Xct.lastWalkSpeed then
        hum.WalkSpeed = getgenv().Xct.lastWalkSpeed
    end

    if getgenv().Xct.humanoidConnection then
        getgenv().Xct.humanoidConnection:Disconnect()
    end

    getgenv().Xct.humanoidConnection = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if hum.WalkSpeed ~= getgenv().Xct.lastWalkSpeed then
            hum.WalkSpeed = getgenv().Xct.lastWalkSpeed
        end
    end)
end

maintab:Textbox("Velocidade do Jogador", function(v)
    local n = tonumber(v)
    if not n then return end
    if n == 8 then n = 16 end
    getgenv().Xct.lastWalkSpeed = n
    getgenv().Xct.applySpeed()
end)

