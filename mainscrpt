local playerESPEnabled = false
local playerConnections = {}

local function applyHighlight(p)
    if p == player then return end
    local char = p.Character
    if not char or not char:IsA("Model") then return end

    local existing = CoreGui:FindFirstChild("XctESP_" .. p.Name)

    if playerESPEnabled then
        if not existing then
            local hl = Instance.new("Highlight")
            hl.Name = "XctESP_" .. p.Name
            hl.Adornee = char
            hl.FillColor = Color3.fromRGB(150, 50, 255)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = CoreGui
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            hum.NameDisplayDistance = math.huge
        end
    else
        if existing then existing:Destroy() end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
            hum.NameDisplayDistance = 100
        end
    end
end

esptab:Toggle("ESP Jogadores", function()
    playerESPEnabled = not playerESPEnabled
    notify("ESP Jogadores", playerESPEnabled and "Ativado." or "Desativado.")

    for _, p in ipairs(Players:GetPlayers()) do
        applyHighlight(p)
    end

    if not playerConnections.added then
        playerConnections.added = Players.PlayerAdded:Connect(function(p)
            p.CharacterAdded:Connect(function()
                if playerESPEnabled then
                    task.wait(1)
                    applyHighlight(p)
                end
            end)
        end)
    end
end)

